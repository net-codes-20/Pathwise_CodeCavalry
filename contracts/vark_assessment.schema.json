{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "vark_assessment.schema.json",
  "title": "VarkAssessment",
  "type": "object",
  "properties": {
    "learner_id": { "type": "string", "format": "uuid" },
    "answers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "question_id": { "type": "string" },
          "selected_option": { "type": "string", "enum": ["visual", "auditory", "read_write", "kinesthetic"] }
        },
        "required": ["question_id", "selected_option"]
      }
    }
  },
  "required": ["learner_id", "answers"]
}
