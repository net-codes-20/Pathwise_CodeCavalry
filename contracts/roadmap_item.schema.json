{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "roadmap_item.schema.json",
  "title": "RoadmapItem",
  "type": "object",
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "resource_id": { "type": "string" },
    "order": { "type": "integer" },
    "status": { "type": "string", "enum": ["upcoming", "current", "completed", "skipped"] },
    "milestone": { "type": "boolean" },
    "reason": { "type": "string" }
  },
  "required": ["resource_id", "order", "status", "milestone", "reason"]
}
