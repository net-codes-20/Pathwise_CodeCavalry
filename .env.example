# .env.example (repo root)
#
# ONE env file for the whole project. Copy this to `.env` at the repo root
# and fill in real values there. backend/, ai/, and frontend/ all load their
# variables from THIS single root .env — no per-folder .env files needed.
#
# NEVER commit the real `.env` file (already covered by .gitignore).

# ============ Supabase (used by backend/) ============
SUPABASE_URL=
SUPABASE_KEY=

# ============ AI providers (used by backend/ and ai/) ============
# Gemini is tried first; OpenRouter then NVIDIA NIM are automatic fallbacks
# if a key is present. You only NEED one of these three set.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/auto

NVIDIA_NIM_API_KEY=
NVIDIA_NIM_MODEL=meta/llama-3.1-8b-instruct

# ============ Backend server config ============
# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173

# ============ Frontend (used by frontend/, must be VITE_-prefixed) ============
# The frontend never holds an API key — only the backend's public base URL.
VITE_API_BASE_URL=http://localhost:8000/api
