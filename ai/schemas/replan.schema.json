{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ReplanResponse",
  "description": "Response shape for ai/prompts/replan.py.",
  "type": "object",
  "properties": {
    "items": {
      "type": "array",
      "description": "Full remaining item list for the new roadmap version (completed/skipped items are copied forward by the backend, not regenerated here).",
      "items": {
        "type": "object",
        "properties": {
          "resource_id": { "type": "string" },
          "order": { "type": "integer" },
          "milestone": { "type": "boolean" },
          "reason": { "type": "string" }
        },
        "required": ["resource_id", "order", "milestone", "reason"]
      }
    },
    "changes_summary": {
      "type": "string",
      "description": "1-3 sentences a learner can read describing what changed and why."
    }
  },
  "required": ["items", "changes_summary"]
}
